{
  // Ctrl+Shift+B compila o arquivo .cpp aberto no editor
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar C++ (arquivo atual)",
      "type": "shell",
      "command": "g++",
      // -pthread: threads (pastas 53-59); -fopenmp: OpenMP (pasta 55); -lws2_32: sockets no Windows (pasta 59)
      "args": ["-std=c++17", "-Wall", "-g", "-pthread", "-fopenmp", "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}.out"],
      "windows": {
        "args": ["-std=c++17", "-Wall", "-g", "-fexec-charset=CP850", "-fopenmp", "${file}", "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe", "-lws2_32"]
      },
      "osx": {
        // o clang da Apple nao tem OpenMP por padrao (instale com: brew install libomp)
        "args": ["-std=c++17", "-Wall", "-g", "-pthread", "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}.out"]
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      // Compila e executa no terminal (aceita cin normalmente)
      "label": "Compilar e executar",
      "type": "shell",
      "command": "\"${fileDirname}/${fileBasenameNoExtension}.out\"",
      "windows": { "command": "& '${fileDirname}\\${fileBasenameNoExtension}.exe'" },
      "options": { "cwd": "${fileDirname}" },
      "dependsOn": "Compilar C++ (arquivo atual)",
      "presentation": { "focus": true, "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
